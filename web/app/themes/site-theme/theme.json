{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": true,
            "customGradient": true,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#1a3c34",
                    "name": "Primary",
                    "slug": "primary"
                },
                {
                    "color": "#10261f",
                    "name": "Primary Dark",
                    "slug": "primary-dark"
                },
                {
                    "color": "#d97b29",
                    "name": "Accent",
                    "slug": "accent"
                },
                {
                    "color": "#f6f5f2",
                    "name": "Neutral 100",
                    "slug": "neutral-100"
                },
                {
                    "color": "#d8d5cf",
                    "name": "Neutral 300",
                    "slug": "neutral-300"
                },
                {
                    "color": "#4a4742",
                    "name": "Neutral 700",
                    "slug": "neutral-700"
                },
                {
                    "color": "#1c1b19",
                    "name": "Neutral 900",
                    "slug": "neutral-900"
                },
                {
                    "color": "#ffffff",
                    "name": "Base",
                    "slug": "base"
                }
            ]
        },
        "custom": {
            "radius-medium": "8px",
            "radius-small": "4px",
            "shadow-soft": "0 2px 12px rgb(0 0 0 / 0.08)"
        },
        "layout": {
            "contentSize": "720px",
            "wideSize": "1100px"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "name": "10",
                    "size": "0.5rem",
                    "slug": "10"
                },
                {
                    "name": "20",
                    "size": "1rem",
                    "slug": "20"
                },
                {
                    "name": "30",
                    "size": "1.5rem",
                    "slug": "30"
                },
                {
                    "name": "40",
                    "size": "2.5rem",
                    "slug": "40"
                },
                {
                    "name": "50",
                    "size": "4rem",
                    "slug": "50"
                }
            ],
            "units": [
                "px",
                "rem",
                "em",
                "%"
            ]
        },
        "typography": {
            "customFontSize": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
                    "name": "Sans",
                    "slug": "sans"
                },
                {
                    "fontFamily": "Georgia, Cambria, \"Times New Roman\", Times, serif",
                    "name": "Serif",
                    "slug": "serif"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium"
                },
                {
                    "name": "Large",
                    "size": "1.375rem",
                    "slug": "large"
                },
                {
                    "fluid": true,
                    "name": "X-Large",
                    "size": "2rem",
                    "slug": "x-large"
                },
                {
                    "fluid": true,
                    "name": "XX-Large",
                    "size": "2.75rem",
                    "slug": "xx-large"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "blocks": {
            "core/button": {
                "border": {
                    "radius": "var(--wp--custom--radius-medium)"
                }
            }
        },
        "color": {
            "background": "var(--wp--preset--color--neutral-100)",
            "text": "var(--wp--preset--color--neutral-900)"
        },
        "elements": {
            "button": {
                "border": {
                    "radius": "var(--wp--custom--radius-medium)"
                },
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--sans)",
                    "fontWeight": "650",
                    "lineHeight": "1.2"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                "typography": {
                    "textDecoration": "underline"
                }
            }
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sans)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "site-header",
            "title": "Site Header"
        },
        {
            "area": "footer",
            "name": "site-footer",
            "title": "Site Footer"
        }
    ],
    "version": 3
}
