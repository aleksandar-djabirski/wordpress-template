{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agency-platform.invalid/schemas/promotion-manifest-v1.json",
  "title": "Agency promotion manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "promotionId", "exportId", "exportedAtUtc", "preparedAtUtc",
    "siteUuid", "siteUrl", "environment", "activeTheme", "baseCommit",
    "deployCommit", "sealedAtUtc", "records", "refusals", "verificationCommands",
    "finalizeStatus", "finalizedAtUtc", "backupId", "settlementStatus",
    "settledAtUtc", "retentionUntilUtc", "hmacKeyId", "hmac"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "promotionId": { "$ref": "#/definitions/uuid" },
    "exportId": { "$ref": "#/definitions/uuid" },
    "exportedAtUtc": { "$ref": "#/definitions/dateTimeUtc" },
    "preparedAtUtc": { "$ref": "#/definitions/dateTimeUtc" },
    "siteUuid": { "type": "string", "minLength": 1 },
    "siteUrl": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "activeTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stylesheet", "version", "gitCommit"],
      "properties": {
        "stylesheet": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "gitCommit": { "oneOf": [{ "$ref": "#/definitions/sha1" }, { "type": "null" }] }
      }
    },
    "baseCommit": { "$ref": "#/definitions/sha1" },
    "deployCommit": { "oneOf": [{ "$ref": "#/definitions/sha1" }, { "type": "null" }] },
    "sealedAtUtc": { "oneOf": [{ "$ref": "#/definitions/dateTimeUtc" }, { "type": "null" }] },
    "records": { "type": "array", "items": { "$ref": "#/definitions/record" } },
    "refusals": { "type": "array", "items": { "$ref": "#/definitions/refusal" } },
    "verificationCommands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "finalizeStatus": { "enum": ["pending", "partial", "complete"] },
    "finalizedAtUtc": { "oneOf": [{ "$ref": "#/definitions/dateTimeUtc" }, { "type": "null" }] },
    "backupId": { "type": ["string", "null"] },
    "settlementStatus": { "enum": ["pending", "confirmed", "rolled-back", "partially-rolled-back"] },
    "settledAtUtc": { "oneOf": [{ "$ref": "#/definitions/dateTimeUtc" }, { "type": "null" }] },
    "retentionUntilUtc": { "oneOf": [{ "$ref": "#/definitions/dateTimeUtc" }, { "type": "null" }] },
    "hmacKeyId": { "type": "string", "minLength": 1 },
    "hmacVersion": { "type": "integer", "enum": [1, 2] },
    "hmac": { "$ref": "#/definitions/sha256" }
  },
  "definitions": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dateTimeUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "provider", "slug", "objectId", "originalContentHash",
        "originalModifiedGmt", "preparedFilePath", "themeRelativePath",
        "preparedFileHash", "originalFileHash", "referenceScan",
        "navigationExpectation", "expectedPostResetHash", "preResetResolvedHash",
        "postFinalizeRecordState", "postFinalizeSemanticHash",
        "postFinalizeModifiedGmt", "finalizeStatus", "finalizeRefusalReason",
        "rollbackStatus", "rollbackRefusalReason", "restoredObjectId"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9-]+:[^\\s]+$" },
        "provider": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "slug": { "type": "string", "minLength": 1 },
        "objectId": { "type": ["integer", "null"] },
        "originalContentHash": { "$ref": "#/definitions/sha256" },
        "originalModifiedGmt": { "type": ["string", "null"] },
        "preparedFilePath": { "type": "string", "minLength": 1 },
        "themeRelativePath": { "type": "string", "minLength": 1 },
        "preparedFileHash": { "$ref": "#/definitions/sha256" },
        "originalFileHash": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "referenceScan": { "type": "array" },
        "navigationExpectation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["originalRef", "exportedNavigationHash", "exportedNavigationIdentity"],
            "properties": {
              "originalRef": { "type": ["integer", "null"] },
              "exportedNavigationHash": { "$ref": "#/definitions/sha256" },
              "exportedNavigationIdentity": { "type": ["object", "null"] }
            }
          }
        },
        "expectedPostResetHash": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "preResetResolvedHash": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "postFinalizeRecordState": { "enum": ["present", "absent", null] },
        "postFinalizeSemanticHash": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
        "postFinalizeModifiedGmt": { "type": ["string", "null"] },
        "finalizeStatus": { "enum": ["pending", "promoted", "refused", "restored"] },
        "finalizeRefusalReason": { "type": ["string", "null"] },
        "rollbackStatus": { "enum": ["not-attempted", "restored", "refused", "restored-hash-mismatch"] },
        "rollbackRefusalReason": { "type": ["string", "null"] },
        "restoredObjectId": { "type": ["integer", "null"] }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordKey", "provider", "slug", "reasonCode", "detail", "blockName", "attribute", "referencedValue", "suggestedPolicy"],
      "properties": {
        "recordKey": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "reasonCode": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "blockName": { "type": ["string", "null"] },
        "attribute": { "type": ["string", "null"] },
        "referencedValue": { "type": ["string", "null"] },
        "suggestedPolicy": { "type": ["string", "null"] }
      }
    }
  }
}
