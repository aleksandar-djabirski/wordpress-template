#!/usr/bin/env bash
#
# Turns the optional COMMERCE PROFILE on for a local/CI environment: installs
# WooCommerce, activates it alongside site-commerce, configures a minimal
# deterministic store, and creates the fixtures the commerce test suites
# (tests/commerce/) assert against.
# Cart and Checkout keep WooCommerce's native BLOCK content (verified, never
# hand-written), and the site-header template part gets a database override
# carrying the Mini-Cart block.
#
# DOCUMENTATION-GRADE: this script is meant to be read top to bottom. It is
# the canonical description of how the commerce profile is switched on, so
# agents and humans can learn the sequence even without running it. Every
# step echoes what it is doing and is idempotent — re-running only fills in
# what is missing.
#
# Run it INSIDE the DDEV web container (`ddev ssh` then `bash
# scripts/enable-commerce`) or on any host that has composer + wp (WP-CLI) on
# PATH. When only `ddev` is present on the host, composer/wp calls are
# transparently routed through it (same resolution as scripts/setup).
#
# EPHEMERAL vs COMMITTED — the one thing to understand before running:
#   `composer require wpackagist-plugin/woocommerce` (step 1) edits
#   composer.json AND composer.lock on disk. For a REAL commerce client that
#   change is COMMITTED — WooCommerce becomes a tracked, audited, reproducible
#   dependency of that client's copy. For the TEMPLATE itself it stays
#   EPHEMERAL: CI runs this script, exercises the commerce suites, and throws
#   the checkout away — the template must never carry a committed WooCommerce
#   require (WooCommerceIsolationTest + the base CI jobs prove the base profile
#   still runs with no WooCommerce at all). The wpackagist.org repository entry
#   in composer.json is the ONLY committed piece; it is inert without a require.
#
# WARNING: the users it creates use throwaway LOCAL-ONLY credentials
# (shop-manager / shop-manager, test-customer / test-customer), same rationale
# as the admin/admin credential scripts/setup creates. Never run this against a
# shared or production environment.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

# --- Environment guard -------------------------------------------------------
# This script seeds DETERMINISTIC, PUBLICLY-KNOWN store fixtures and credentials
# — shop-manager/shop-manager and test-customer/test-customer users, test
# products, coupon TESTCOUPON, a live store with guest checkout. Harmless on a
# throwaway local box, catastrophic anywhere shared: known-password accounts and
# fake products would go live on a real store. So it runs ONLY when the
# environment is development or local, and this check is first — before any
# composer/wp/ddev call (including the WooCommerce `composer require`) — so
# nothing is installed or created otherwise.
#
# The environment is read from .env's WP_ENV WITHOUT booting WordPress. If .env
# is ABSENT it is treated as development (matches scripts/setup, which creates it
# from .env.example with WP_ENV=development). A present-but-empty or missing
# WP_ENV is treated as UNSAFE — Bedrock maps an unset WP_ENV to production.
# This .env check is FIRST and pre-boot: it runs BEFORE any composer/wp/ddev
# call, so a wrong environment installs nothing at all.
#
# A SECOND, read-only runtime cross-check (wp_get_environment_type()) runs
# after tooling resolution, before step 1 — see the block below the tooling
# resolution. The .env check stays load-bearing: the runtime check cannot run
# before WordPress exists.
#
# There is deliberately NO override flag: seeding a non-development box on
# purpose means editing .env (or this script), and that friction is the point.
require_development_environment() {
  local env_value='development'
  if [ -f .env ]; then
    # Last WP_ENV= wins; tolerate leading whitespace, trailing CR, and quotes.
    env_value="$(grep -E '^[[:space:]]*WP_ENV=' .env | tail -n1 | cut -d= -f2- || true)"
    env_value="${env_value#"${env_value%%[![:space:]]*}"}"    # ltrim
    env_value="${env_value%"${env_value##*[![:space:]]}"}"    # rtrim (incl. CR)
    env_value="${env_value%\"}"; env_value="${env_value#\"}"  # strip "quotes"
    env_value="${env_value%\'}"; env_value="${env_value#\'}"  # strip 'quotes'
  fi

  case "${env_value}" in
    development | local)
      echo "==> Environment guard: WP_ENV='${env_value}' — proceeding."
      ;;
    *)
      echo "" >&2
      echo "REFUSING TO RUN: scripts/enable-commerce is a LOCAL-DEVELOPMENT seeder." >&2
      echo "  Detected WP_ENV='${env_value:-<unset>}' — it must be 'development' or 'local'." >&2
      echo "" >&2
      echo "  This script seeds deterministic, PUBLICLY-KNOWN artifacts:" >&2
      echo "    - a shop-manager user     shop-manager / shop-manager" >&2
      echo "    - a test-customer user    test-customer / test-customer" >&2
      echo "    - fixture products 'Test Simple Product' / 'Test Variable Product'" >&2
      echo "    - coupon TESTCOUPON, a live store, guest checkout, and the COD gateway" >&2
      echo "  On a shared, staging, or production store that is a critical security" >&2
      echo "  and commercial exposure — known-password accounts and fake products live." >&2
      echo "" >&2
      echo "  There is no override flag: to seed a non-development box on purpose," >&2
      echo "  change WP_ENV in .env (or edit this script). That friction is the point." >&2
      exit 1
      ;;
  esac
}

require_development_environment

# --- Tooling resolution ------------------------------------------------------
# Prefer native binaries; fall back to running them through ddev (mirrors
# scripts/setup so this script behaves the same inside and outside the
# container, and on a CI host where only `ddev` is on PATH).
if command -v composer >/dev/null 2>&1; then
  COMPOSER=(composer)
elif command -v ddev >/dev/null 2>&1; then
  COMPOSER=(ddev composer)
else
  echo "error: need 'composer' or 'ddev' on PATH." >&2
  exit 1
fi

if command -v wp >/dev/null 2>&1; then
  WP=(wp)
elif command -v ddev >/dev/null 2>&1; then
  WP=(ddev wp)
else
  echo "error: need 'wp' (WP-CLI) or 'ddev' on PATH." >&2
  exit 1
fi

# --- Runtime environment cross-check ----------------------------------------
# Belt-and-braces second guard: .env's WP_ENV is the build-time intent, but the
# RUNTIME environment — wp_get_environment_type(), which Bedrock maps from
# WP_ENVIRONMENT_TYPE/WP_ENV — is what WordPress actually runs as. An exported
# WP_ENVIRONMENT_TYPE overrides .env's WP_ENV, so the .env check alone can pass
# while WordPress runs as production. This check is deliberately placed AFTER
# tooling resolution (it needs wp) but BEFORE step 1, so it is still read-only:
# `wp eval` only boots WordPress, nothing is installed or written either way.
#
# A failed or empty result (no container, WordPress not installed yet —
# scripts/setup runs this script's siblings before WP exists) means "cannot
# determine" and does NOT refuse; only a reachable WordPress that reports an
# unsafe environment refuses.
runtime_env="$("${WP[@]}" eval 'echo wp_get_environment_type();' 2>/dev/null | tr -d '\r' || true)"
case "${runtime_env}" in
  development | local)
    echo "==> Environment guard: wp_get_environment_type()='${runtime_env}' — proceeding."
    ;;
  '')
    echo "==> Environment guard: runtime environment could not be determined — continuing (no container or pre-boot)."
    ;;
  *)
    echo "" >&2
    echo "REFUSING TO RUN: scripts/enable-commerce is a LOCAL-DEVELOPMENT seeder." >&2
    echo "  Detected runtime environment '${runtime_env}' — it must be 'development' or 'local'." >&2
    echo "  (wp_get_environment_type() overrides .env's WP_ENV when WP_ENVIRONMENT_TYPE is exported.)" >&2
    echo "" >&2
    echo "  There is no override flag: to seed a non-development box on purpose, fix the" >&2
    echo "  runtime environment (or edit this script). That friction is the point." >&2
    exit 1
    ;;
esac

# --- 1. WooCommerce as a Composer dependency ---------------------------------
# Composer is the required install path (a manual `wp plugin install` is
# invisible to Git, `composer audit`, Dependabot, and reproducible deploys) —
# see docs/adding-commerce-behaviour.md. The wpackagist.org repository this
# resolves from is already declared in composer.json; only the `require` is
# added here. EPHEMERAL for the template, COMMITTED for a real client (see the
# header). Skipped when WooCommerce is already required, so re-runs are no-ops.
echo "==> [1/11] Requiring WooCommerce via Composer (LOCAL edit to composer.json/lock)"
if "${COMPOSER[@]}" show wpackagist-plugin/woocommerce >/dev/null 2>&1; then
  echo "    wpackagist-plugin/woocommerce already installed — skipping require."
else
  "${COMPOSER[@]}" require wpackagist-plugin/woocommerce --no-interaction
fi

# --- 2. Activate WooCommerce + site-commerce ---------------------------------
# Activating WooCommerce makes SiteCommerce\Plugin::maybe_boot() take its
# booted branch (class_exists('WooCommerce') is now true), wiring
# ExampleProductRules and CommerceSanitizeStep. `wp plugin activate` is
# idempotent.
echo "==> [2/11] Activating woocommerce + site-commerce"
"${WP[@]}" plugin activate woocommerce site-commerce

# --- 3. High-Performance Order Storage (HPOS) --------------------------------
# Enable HPOS so orders live in the wc_orders / wc_order_addresses tables — the
# storage backend CommerceSanitizeStep's HPOS branch scrubs and the commerce
# integration suite exercises. `wp wc hpos enable` is the current command
# (`wp wc cot enable` is deprecated since WooCommerce 8.9) and is idempotent:
# it warns (exit 0) when HPOS is already on. Safe on a fresh store because no
# orders exist yet, so there is nothing to migrate.
echo "==> [3/11] Enabling High-Performance Order Storage (HPOS)"
"${WP[@]}" wc hpos enable

# --- 4. Shop / cart / checkout / my-account pages ----------------------------
# WooCommerce creates these on activation; running the install_pages tool again
# re-creates any that are missing and is idempotent otherwise.
#
# NATIVE BLOCK cart/checkout: this script used to swap both pages to the
# classic [woocommerce_cart] / [woocommerce_checkout] shortcodes because the
# block Cart/Checkout hydrate client-side and the old server-rendered selectors
# were easier to automate. On a block theme that would prove the wrong thing —
# the commerce suite must exercise the block workflow the client actually gets.
# So the pages now keep WooCommerce's own default BLOCK content.
#
# The markup is never hand-written here (it changes between WooCommerce
# releases). Instead: a page whose content is EXACTLY the legacy shortcode —
# the canonical generated page, once surrounding whitespace is ignored — is
# force deleted, and install_pages recreates it with the CURRENT default block
# content. A page that mixes the shortcode with custom content is a
# developer's page: it is NOT deleted — the script refuses and tells the
# operator to convert it by hand. Then both pages are verified — a store whose
# checkout silently fell back to a shortcode must fail loudly, not run a green
# test suite against the wrong rendering path.
echo "==> [4/11] Ensuring shop/cart/checkout/my-account pages exist (native block cart/checkout)"
for page in cart checkout; do
  page_id="$("${WP[@]}" option get "woocommerce_${page}_page_id" 2>/dev/null | tr -d '\r')"
  if [ -n "${page_id}" ]; then
    page_content="$("${WP[@]}" post get "${page_id}" --field=post_content 2>/dev/null | tr -d '\r' || true)"
    page_content_trimmed="$(printf '%s' "${page_content}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [ "${page_content_trimmed}" = "[woocommerce_${page}]" ]; then
      "${WP[@]}" post delete "${page_id}" --force >/dev/null
      echo "    removed the legacy shortcode ${page} page (#${page_id}); it will be recreated with block content."
    elif printf '%s' "${page_content}" | grep -q "\[woocommerce_${page}\]"; then
      echo "" >&2
      echo "FAILED: the ${page} page (#${page_id}) mixes the legacy [woocommerce_${page}]" >&2
      echo "  shortcode with custom content, so it will NOT be force-deleted." >&2
      echo "  Convert the page to the native block content by hand, then re-run this script." >&2
      exit 1
    fi
  fi
done

"${WP[@]}" wc tool run install_pages --user=admin >/dev/null

for page in cart checkout; do
  page_id="$("${WP[@]}" option get "woocommerce_${page}_page_id" 2>/dev/null | tr -d '\r')"
  if [ -z "${page_id}" ] \
      || ! "${WP[@]}" post get "${page_id}" --field=post_content 2>/dev/null | grep -q "wp:woocommerce/${page}"; then
    echo "" >&2
    echo "FAILED: the ${page} page does not hold the native block content." >&2
    echo "  Expected a 'wp:woocommerce/${page}' block in page #${page_id:-<none>}." >&2
    echo "  The commerce suites must exercise the block checkout, not a shortcode fallback." >&2
    exit 1
  fi
  echo "    ${page} page (#${page_id}) holds the native block content."
done

# --- 5. Store basics ---------------------------------------------------------
# Currency is deliberately left at WooCommerce's USD default — the fixtures and
# the e2e assertions below are written in dollars, so keeping USD keeps them
# deterministic across environments. A base country/address is set so shipping
# and tax have a well-defined origin, and guest checkout is enabled so the e2e
# journey can place an order without an account.
#
# "Coming soon" mode: WooCommerce 8.6+ defaults a fresh install to
# woocommerce_coming_soon=yes / woocommerce_store_pages_only=yes, which hides the
# shop/product/cart/checkout pages behind a coming-soon screen until a store
# owner launches. That screen would make every storefront e2e journey fail, so
# the store is explicitly taken live here.
echo "==> [5/11] Configuring store basics (live store, country/address, guest checkout; currency stays USD)"
"${WP[@]}" option update woocommerce_coming_soon "no" >/dev/null
"${WP[@]}" option update woocommerce_store_pages_only "no" >/dev/null
"${WP[@]}" option update woocommerce_default_country "US:CA" >/dev/null
"${WP[@]}" option update woocommerce_store_address "123 Test Street" >/dev/null
"${WP[@]}" option update woocommerce_store_city "Los Angeles" >/dev/null
"${WP[@]}" option update woocommerce_store_postcode "90001" >/dev/null
"${WP[@]}" option update woocommerce_enable_guest_checkout "yes" >/dev/null
echo "    store live (coming-soon off), base country US:CA, guest checkout enabled, currency left at USD default."

# --- 6. Cash on Delivery payment gateway -------------------------------------
# COD needs no external gateway credentials, so it is the deterministic choice
# for an automated checkout. WooCommerce reads this gateway's config from the
# woocommerce_cod_settings option; setting the whole array (WC merges any
# missing keys with the gateway's field defaults) enables it. Idempotent —
# re-running reports the value as unchanged.
echo "==> [6/11] Enabling the Cash on Delivery (COD) payment gateway"
"${WP[@]}" option update woocommerce_cod_settings --format=json \
  '{"enabled":"yes","title":"Cash on delivery"}' >/dev/null
echo "    COD enabled."

# --- 7. Shipping -------------------------------------------------------------
# A checkout with a physical product needs a resolvable shipping method or
# WooCommerce blocks the order. Add a single Free Shipping method to the
# built-in "Locations not covered by your other zones" zone (id 0) so shipping
# always resolves for any address, keeping the e2e checkout deterministic.
echo "==> [7/11] Ensuring a Free Shipping method on the default zone"
if "${WP[@]}" wc shipping_zone_method list 0 --user=admin --field=method_id 2>/dev/null \
    | grep -q 'free_shipping'; then
  echo "    a shipping method already exists on the default zone — skipping."
else
  "${WP[@]}" wc shipping_zone_method create 0 --method_id=free_shipping --user=admin >/dev/null
  echo "    added Free Shipping to the default zone."
fi

# --- 8. Fixture products + coupon --------------------------------------------
# The commerce test suites (tests/commerce/) assert against these exact
# fixtures. Each is created only when absent (looked up by slug), so re-running
# never duplicates them. `wp wc` product/coupon commands go through the REST
# controller, so they need --user=admin.
echo "==> [8/11] Creating fixture products and coupon (idempotent)"

if [ -z "$("${WP[@]}" post list --post_type=product --name=test-simple-product --field=ID 2>/dev/null | tr -d '\r')" ]; then
  "${WP[@]}" wc product create --name="Test Simple Product" --type=simple \
    --regular_price=19.99 --user=admin --porcelain >/dev/null
  echo "    created simple product 'Test Simple Product' (\$19.99, in stock)."
else
  echo "    'Test Simple Product' already exists — skipping."
fi

if [ -z "$("${WP[@]}" post list --post_type=product --name=test-variable-product --field=ID 2>/dev/null | tr -d '\r')" ]; then
  variable_id="$("${WP[@]}" wc product create --name="Test Variable Product" --type=variable \
    --attributes='[{"name":"Size","visible":true,"variation":true,"options":["S","M"]}]' \
    --user=admin --porcelain 2>/dev/null | tr -d '\r')"
  "${WP[@]}" wc product_variation create "${variable_id}" --regular_price=24.99 \
    --attributes='[{"name":"Size","option":"S"}]' --user=admin --porcelain >/dev/null
  "${WP[@]}" wc product_variation create "${variable_id}" --regular_price=29.99 \
    --attributes='[{"name":"Size","option":"M"}]' --user=admin --porcelain >/dev/null
  echo "    created variable product 'Test Variable Product' (Size S \$24.99 / M \$29.99)."
else
  echo "    'Test Variable Product' already exists — skipping."
fi

if [ -z "$("${WP[@]}" post list --post_type=shop_coupon --name=testcoupon --field=ID 2>/dev/null | tr -d '\r')" ]; then
  "${WP[@]}" wc shop_coupon create --code=TESTCOUPON --discount_type=percent \
    --amount=10 --user=admin --porcelain >/dev/null
  echo "    created coupon 'TESTCOUPON' (10% off)."
else
  echo "    coupon 'TESTCOUPON' already exists — skipping."
fi

# --- 9. Commerce test users --------------------------------------------------
# WARNING: throwaway LOCAL-ONLY credentials (same rationale as scripts/setup's
# admin/admin and client-editor/client-editor). `client_shop_manager` is the
# starter's restricted shop role (AgencyPlatform\Roles\ShopRole, registered
# only when WooCommerce is active); the `customer` role is WooCommerce's own,
# used by the e2e account-history journey to place an order tied to an account.
echo "==> [9/11] Ensuring commerce test users exist (LOCAL-ONLY credentials)"
if "${WP[@]}" user get shop-manager >/dev/null 2>&1; then
  echo "    user 'shop-manager' already exists — skipping."
else
  "${WP[@]}" user create shop-manager shop-manager@example.invalid \
    --role=client_shop_manager --display_name="Shop Manager" \
    --user_pass=shop-manager --porcelain >/dev/null
  echo "    created 'shop-manager' (role: client_shop_manager, LOCAL-ONLY password: shop-manager)."
fi

if "${WP[@]}" user get test-customer >/dev/null 2>&1; then
  echo "    user 'test-customer' already exists — skipping."
else
  "${WP[@]}" user create test-customer test-customer@example.invalid \
    --role=customer --display_name="Test Customer" \
    --user_pass=test-customer --porcelain >/dev/null
  echo "    created 'test-customer' (role: customer, LOCAL-ONLY password: test-customer)."
fi

# --- 10. Header Mini-Cart (database template-part override) ------------------
# The base theme's parts/site-header.html stays commerce-free: it ships in every
# project built from this starter, and a commerce block there would render as a
# broken block on a site with no store. The supported composition is the
# `site-commerce/header-mini-cart` pattern a client inserts through the Site
# Editor.
#
# For a deterministic test store, that client action is performed here as a
# DATABASE OVERRIDE of the site-header template part: the Git baseline part plus
# the Mini-Cart block appended. This is a legitimate, expected override under the
# project's source-of-truth model (`wp agency check-overrides` reports it; it is
# never automatically promoted back into Git). Idempotent: an existing override
# that already carries the Mini-Cart is left alone; an override WITHOUT it keeps
# its current content and gets the Mini-Cart APPENDED (never replaced — the
# client action of inserting a pattern does not destroy the header); only when
# no override exists is the Git baseline the starting point.
echo "==> [10/11] Seeding the header Mini-Cart as a template-part override"
HEADER_PART_SOURCE="web/app/themes/site-theme/parts/site-header.html"
MINI_CART_PATTERN="web/app/plugins/site-commerce/patterns/header-mini-cart.html"
for required in "${HEADER_PART_SOURCE}" "${MINI_CART_PATTERN}"; do
  if [ ! -f "${required}" ]; then
    echo "error: ${required} is missing; cannot seed the header Mini-Cart override." >&2
    exit 1
  fi
done

# The content file lives INSIDE the DDEV mount: var/agency-state/ is
# gitignored, and this script runs BOTH on the host (CI invokes it directly)
# and in the container, while `wp post create/update` always execute INSIDE
# the container. A host-side `mktemp` path under /tmp is invisible there, so
# the file uses a REPOSITORY-RELATIVE path — it resolves identically on both
# sides because the host and the container both work from the project root.
# The file is removed on every branch below.
header_part_file="var/agency-state/site-header-override.html"
mkdir -p "var/agency-state"

header_part_id="$("${WP[@]}" post list --post_type=wp_template_part --name=site-header \
  --post_status=any --field=ID --format=ids 2>/dev/null | tr -d '\r' | awk '{print $1}')"

if [ -n "${header_part_id}" ]; then
  "${WP[@]}" post get "${header_part_id}" --field=post_content > "${header_part_file}" 2>/dev/null
  # Match the ACTUAL block, not the bare substring: any content merely
  # mentioning "mini-cart" (a paragraph, a CSS class, a comment) must not count
  # as carrying the Mini-Cart.
  if grep -q 'wp:woocommerce/mini-cart' "${header_part_file}"; then
    rm -f "${header_part_file}"
    echo "    site-header override already carries the Mini-Cart — skipping."
  else
    printf '\n' >> "${header_part_file}"
    # The same composition site-commerce registers as its header pattern, read
    # from disk so this script never names a commerce block itself.
    cat "${MINI_CART_PATTERN}" >> "${header_part_file}"
    "${WP[@]}" post update "${header_part_id}" "${header_part_file}" >/dev/null
    rm -f "${header_part_file}"
    echo "    appended the Mini-Cart to the existing site-header override (#${header_part_id})."
  fi
else
  cat "${HEADER_PART_SOURCE}" > "${header_part_file}"
  printf '\n' >> "${header_part_file}"
  # The same composition site-commerce registers as its header pattern, read
  # from disk so this script never names a commerce block itself.
  cat "${MINI_CART_PATTERN}" >> "${header_part_file}"

  header_part_id="$("${WP[@]}" post create "${header_part_file}" \
    --post_type=wp_template_part --post_title="Site Header" --post_name=site-header \
    --post_status=publish --porcelain 2>/dev/null | tr -d '\r')"
  rm -f "${header_part_file}"
  echo "    created the site-header override (#${header_part_id}) from the theme baseline with the Mini-Cart."
fi

"${WP[@]}" post term set "${header_part_id}" wp_theme site-theme >/dev/null
"${WP[@]}" post term set "${header_part_id}" wp_template_part_area header >/dev/null

# --- 11. Permalinks ----------------------------------------------------------
# WooCommerce product/shop URLs (/product/..., /shop/) need a non-default
# permalink structure; flush after registering WooCommerce's rewrite rules so
# the storefront the e2e specs navigate resolves. Mirrors scripts/setup and the
# e2e CI job's permalink step.
echo "==> [11/11] Setting pretty permalinks and flushing rewrite rules"
"${WP[@]}" rewrite structure '/%postname%/' --hard >/dev/null
"${WP[@]}" rewrite flush --hard >/dev/null
echo "    permalinks set to /%postname%/ and rules flushed."

echo
echo "==> Commerce profile enabled."
echo "    Shop manager login (LOCAL ONLY): shop-manager / shop-manager"
echo "    Test customer login (LOCAL ONLY): test-customer / test-customer"
echo "    Run the commerce suites:"
echo "      ddev composer test:integration:commerce"
echo "      COMMERCE=1 npx playwright test tests/commerce/e2e"
echo "    Cart/Checkout use the native blocks; the site-header override carries the Mini-Cart."
