#!/usr/bin/env bash
#
# One-shot local environment bootstrap for the agency-starter.
#
# DOCUMENTATION-GRADE: this script is meant to be read top to bottom. It is
# the canonical description of how a working local install comes together, so
# agents and humans can learn the sequence even without running it.
#
# Run it INSIDE the DDEV web container (`ddev ssh` then `bash scripts/setup`)
# or on any host that has php, composer, wp (WP-CLI) and node on PATH. When
# only `ddev` is present on the host, composer/wp calls are transparently
# routed through it.
#
# It is idempotent: every step checks the current state first, so re-running
# it only fills in what is missing and never clobbers an existing .env or a
# already-installed site.
#
# WARNING: the WordPress admin it creates uses the throwaway credentials
# admin / admin for LOCAL DEVELOPMENT ONLY. Never run this against a shared or
# production environment.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

# --- Environment guard -------------------------------------------------------
# This script seeds DETERMINISTIC, PUBLICLY-KNOWN local credentials and fixtures
# — a WordPress administrator admin/admin, a client-editor/client-editor user, a
# Primary site navigation, and a Demo page. Harmless on a throwaway local box, catastrophic
# anywhere shared: it would plant a known-password administrator on a live site.
# So it runs ONLY when the environment is development or local, and this check is
# first — before any composer/wp/ddev call — so nothing happens otherwise.
#
# The environment is read from .env's WP_ENV WITHOUT booting WordPress (this
# script runs before WP is installed). If .env is ABSENT, setup is about to
# create it from .env.example (WP_ENV=development), so a missing .env is treated
# as development and allowed. A present-but-empty or missing WP_ENV is treated
# as UNSAFE — Bedrock maps an unset WP_ENV to production.
#
# There is deliberately NO override flag: seeding a non-development box on
# purpose means editing .env (or this script), and that friction is the point.
require_development_environment() {
  local env_value='development'
  if [ -f .env ]; then
    # Last WP_ENV= wins; tolerate leading whitespace, trailing CR, and quotes.
    env_value="$(grep -E '^[[:space:]]*WP_ENV=' .env | tail -n1 | cut -d= -f2- || true)"
    env_value="${env_value#"${env_value%%[![:space:]]*}"}"    # ltrim
    env_value="${env_value%"${env_value##*[![:space:]]}"}"    # rtrim (incl. CR)
    env_value="${env_value%\"}"; env_value="${env_value#\"}"  # strip "quotes"
    env_value="${env_value%\'}"; env_value="${env_value#\'}"  # strip 'quotes'
  fi

  case "${env_value}" in
    development | local)
      echo "==> Environment guard: WP_ENV='${env_value}' — proceeding."
      ;;
    *)
      echo "" >&2
      echo "REFUSING TO RUN: scripts/setup is a LOCAL-DEVELOPMENT bootstrap." >&2
      echo "  Detected WP_ENV='${env_value:-<unset>}' — it must be 'development' or 'local'." >&2
      echo "" >&2
      echo "  This script seeds deterministic, PUBLICLY-KNOWN artifacts:" >&2
      echo "    - a WordPress administrator   admin / admin" >&2
      echo "    - a client-editor user        client-editor / client-editor" >&2
      echo "    - a site navigation menu, a Demo page, and pretty permalinks" >&2
      echo "  On a shared, staging, or production site that is a critical security" >&2
      echo "  exposure — a known-password administrator on a live install." >&2
      echo "" >&2
      echo "  There is no override flag: to seed a non-development box on purpose," >&2
      echo "  change WP_ENV in .env (or edit this script). That friction is the point." >&2
      exit 1
      ;;
  esac
}

require_development_environment

# --- Tooling resolution ------------------------------------------------------
# Prefer native binaries; fall back to running them through ddev.
if command -v composer >/dev/null 2>&1; then
  COMPOSER=(composer)
elif command -v ddev >/dev/null 2>&1; then
  COMPOSER=(ddev composer)
else
  echo "error: need 'composer' or 'ddev' on PATH." >&2
  exit 1
fi

if command -v wp >/dev/null 2>&1; then
  WP=(wp)
elif command -v ddev >/dev/null 2>&1; then
  WP=(ddev wp)
else
  echo "error: need 'wp' (WP-CLI) or 'ddev' on PATH." >&2
  exit 1
fi

# --- 1. PHP dependencies -----------------------------------------------------
echo "==> [1/11] Installing Composer dependencies (WordPress core + tooling)"
"${COMPOSER[@]}" install

# --- 2. Environment file + salts --------------------------------------------
echo "==> [2/11] Ensuring .env exists with real auth salts"
if [ -f .env ]; then
  echo "    .env already present — leaving it untouched."
else
  cp .env.example .env
  echo "    created .env from .env.example."
  # .env.example ships every AUTH_KEY/SALT as the literal 'generateme'.
  # Replace them one at a time with fresh random values so each key/salt is
  # unique. openssl is available in the DDEV web container.
  if command -v openssl >/dev/null 2>&1; then
    while grep -q 'generateme' .env; do
      salt="$(openssl rand -base64 48 | tr -d '\n')"
      # Escape sed-special characters (\ / & |) in the generated salt.
      escaped="$(printf '%s' "${salt}" | sed -e 's/[\\/&|]/\\&/g')"
      # Replace only the FIRST remaining 'generateme'.
      sed -i "0,/generateme/s|generateme|${escaped}|" .env
    done
    echo "    generated unique random salts for all AUTH_* keys."
  else
    echo "    warning: openssl not found — .env still contains 'generateme'" >&2
    echo "             placeholders; replace them before using this install." >&2
  fi
fi

# The site URL comes from WP_HOME in .env (default: the ddev.site host).
WP_HOME_VALUE="$(grep -E '^WP_HOME=' .env | head -n1 | cut -d= -f2-)"
WP_HOME_VALUE="${WP_HOME_VALUE%\"}"; WP_HOME_VALUE="${WP_HOME_VALUE#\"}"
WP_HOME_VALUE="${WP_HOME_VALUE%\'}"; WP_HOME_VALUE="${WP_HOME_VALUE#\'}"
WP_HOME_VALUE="${WP_HOME_VALUE:-https://agency-starter.ddev.site}"

# --- 3. WordPress core install ----------------------------------------------
echo "==> [3/11] Installing WordPress core (if not already installed)"
if "${WP[@]}" core is-installed >/dev/null 2>&1; then
  echo "    WordPress is already installed — skipping."
else
  echo "    installing at ${WP_HOME_VALUE} with LOCAL-ONLY admin (admin/admin)."
  "${WP[@]}" core install \
    --url="${WP_HOME_VALUE}" \
    --title="Agency Starter (local)" \
    --admin_user="admin" \
    --admin_password="admin" \
    --admin_email="admin@example.invalid" \
    --skip-email
fi

# --- 4. Theme ----------------------------------------------------------------
echo "==> [4/11] Activating the site-theme"
"${WP[@]}" theme activate site-theme

# --- 5. Base-profile plugins -------------------------------------------------
# site-commerce is intentionally NOT activated here: it only does anything
# when WooCommerce is present, and the base profile ships without it.
echo "==> [5/11] Activating base-profile plugins (site-core, site-integrations)"
"${WP[@]}" plugin activate site-core site-integrations

# --- 6. Node dependencies ----------------------------------------------------
echo "==> [6/11] Installing Node dependencies"
if [ -f package-lock.json ]; then
  npm ci
else
  npm install
fi

# --- 7. Block build ----------------------------------------------------------
echo "==> [7/11] Building block editor assets (wp-scripts)"
npm run build

# --- 8. Client editor test user ---------------------------------------------
# WARNING: this user's password is the throwaway credential client-editor /
# client-editor, for LOCAL DEVELOPMENT ONLY (same rationale as the admin/admin
# credential in step 3) — without --user_pass, `wp user create` generates a
# random password, which is fine for a human but breaks e2e specs that need
# to log this user in (see tests/e2e/helpers/auth.ts). Never run this against
# a shared or production environment.
echo "==> [8/11] Ensuring a client-editor test user exists"
if "${WP[@]}" user get client-editor >/dev/null 2>&1; then
  echo "    user 'client-editor' already exists — skipping."
else
  "${WP[@]}" user create client-editor client-editor@example.invalid \
    --role=client_editor \
    --display_name="Client Editor" \
    --user_pass=client-editor \
    --porcelain >/dev/null
  echo "    created 'client-editor' (role: client_editor, LOCAL-ONLY password: client-editor)."
fi

# --- 9. Site navigation ------------------------------------------------------
# The block theme's parts/site-header.html renders <!-- wp:navigation /--> with
# no ref. WordPress resolves that block at render time to the most recently
# published non-empty wp_navigation record. Seed one named record and leave any
# other records alone, so this step is idempotent without being exclusive.
echo "==> [9/11] Ensuring a site navigation menu exists"
if [ -n "$("${WP[@]}" post list --post_type=wp_navigation --post_status=publish --title="Primary" --field=ID)" ]; then
  echo "    the Primary navigation menu already exists — skipping."
else
  nav_content="<!-- wp:navigation-link {\"label\":\"Home\",\"url\":\"${WP_HOME_VALUE}/\",\"kind\":\"custom\",\"isTopLevelLink\":true} /-->"
  sample_page_id="$("${WP[@]}" post list --post_type=page --name=sample-page --field=ID 2>/dev/null | head -n1)"
  if [ -n "${sample_page_id}" ]; then
    nav_content="${nav_content}<!-- wp:navigation-link {\"label\":\"Sample Page\",\"id\":${sample_page_id},\"type\":\"page\",\"kind\":\"post-type\",\"url\":\"${WP_HOME_VALUE}/sample-page/\"} /-->"
  fi
  "${WP[@]}" post create \
    --post_type=wp_navigation \
    --post_status=publish \
    --post_title="Primary" \
    --post_content="${nav_content}" \
    --porcelain >/dev/null
fi

echo "==> [10/11] Ensuring the Demo page exists"
if "${WP[@]}" post list --post_type=page --name=demo --field=ID | grep -q '[0-9]'; then
  echo "    the Demo page already exists — skipping."
else
  # The demo page carries an image, and a media id is environment-specific, so
  # the fixture ships placeholder tokens that are substituted here rather than
  # a baked-in id that would break on every other install.
  media_id="$("${WP[@]}" media import tests/fixtures/demo-media.png --title="Demo media" --porcelain)"
  media_url="$("${WP[@]}" eval "echo wp_get_attachment_url( ${media_id} );")"
  demo_content="$(sed -e "s|{{MEDIA_ID}}|${media_id}|g" -e "s|{{MEDIA_URL}}|${media_url}|g" tests/fixtures/demo-page.html)"
  "${WP[@]}" post create \
    --post_type=page \
    --post_status=publish \
    --post_title="Demo" \
    --post_name=demo \
    --post_content="${demo_content}" \
    --porcelain >/dev/null
fi

echo "==> [11/11] Setting pretty permalinks"
"${WP[@]}" rewrite structure '/%postname%/' --hard

echo
echo "==> Setup complete. Site: ${WP_HOME_VALUE}"
echo "    Admin login (LOCAL ONLY): admin / admin"
echo "    Client editor login (LOCAL ONLY): client-editor / client-editor"
