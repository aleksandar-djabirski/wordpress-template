# DDEV default database credentials — matches .ddev/config.yaml.
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db

WP_ENV=development
WP_HOME=https://agency-starter.ddev.site
WP_SITEURL=${WP_HOME}/wp

# Auth unique keys and salts.
# These placeholder values are NOT secure — scripts/setup (Task 8) generates
# real random salts for local/CI use. Never deploy with `generateme` salts.
AUTH_KEY=generateme
SECURE_AUTH_KEY=generateme
LOGGED_IN_KEY=generateme
NONCE_KEY=generateme
AUTH_SALT=generateme
SECURE_AUTH_SALT=generateme
LOGGED_IN_SALT=generateme
NONCE_SALT=generateme

# Dev/staging safety default: keeps SiteIntegrations\LeadDelivery\WebhookLeadDelivery
# from firing in non-production environments. See config/environments/{development,staging}.php.
# NOTE: the actual kill-switch is HARDCODED there as
# `Config::define('AGENCY_DISABLE_OUTBOUND_WEBHOOKS', true)` — it does not read this
# variable. This line is informational/reserved only; editing or removing it here does
# not change behavior in development or staging.
AGENCY_DISABLE_OUTBOUND_WEBHOOKS=true

# Dev/staging safety default: AgencyPlatform\Security\MailGuard suppresses ALL
# real outbound email in non-production environments (via the `pre_wp_mail`
# filter). Like AGENCY_DISABLE_OUTBOUND_WEBHOOKS above, the real switch is
# HARDCODED in config/environments/{development,staging}.php as
# `Config::define('AGENCY_ALLOW_OUTBOUND_EMAIL', false)`; it does not read this
# variable. Flip that constant to true (not this line) only to send real mail
# to a safe test mailbox. This line is informational/reserved only.
AGENCY_ALLOW_OUTBOUND_EMAIL=false

# Real webhook endpoint for lead delivery; left empty by default (dev/staging
# use SiteIntegrations\LeadDelivery\FakeLeadDelivery instead).
LEAD_WEBHOOK_URL=''

# ------------------------------------------------------------------
# State subsystem (wp agency state-export / state-diff).
# ------------------------------------------------------------------
# Where promotion manifests and backup payloads are written. Relative paths
# resolve against the repository root. State export requires an explicit
# --output path; use var/agency-state/<file>.json when this directory is wanted.
# AGENCY_STATE_DIR=var/agency-state
#
# Repository root, when WP-CLI does not run from it (DDEV, CI).
# Default: autodetected upwards from ABSPATH.
# AGENCY_REPO_ROOT=/var/www/html
#
# HMAC keyring shared between the machine that exports/prepares and the
# production host that finalises. WordPress salts differ per environment
# and are NEVER used as a fallback — a missing keyring is a hard failure.
# Every key must be at least 32 characters. Rotate by adding a new key id,
# advancing AGENCY_PROMOTION_HMAC_SIGNING_KEY_ID, and keeping the old key
# until outstanding bundles/manifests expire.
# AGENCY_PROMOTION_HMAC_KEYS='{"2026-01":"replace-with-32+-random-characters"}'
# AGENCY_PROMOTION_HMAC_SIGNING_KEY_ID=2026-01
